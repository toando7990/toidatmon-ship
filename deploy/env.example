# ============================================================
# .env — VPS Tôi Đặt Món (vps-worker + bkav-proxy)
# Điền giá trị THẬT cho các dòng trống. KHÔNG commit file .env lên GitHub.
# ============================================================

NODE_ENV=production
PORT=__WORKER_PORT__

# --- Địa chỉ công khai ---
VPS_PUBLIC_URL=https://__DOMAIN_API__
FRONTEND_PUBLIC_URL=https://toidatmon.vn
# Để trống = cho phép mọi origin. Code hiện chỉ so khớp chính xác từng origin
# (cách nhau dấu phẩy), chưa hỗ trợ *.toidatmon.vn — sẽ bổ sung ở giai đoạn 1.
CORS_ORIGIN=

# --- Dữ liệu ---
DB_PATH=__DATA_DIR__/app.db
UPLOAD_DIR=__DATA_DIR__/uploads
BACKUP_DIR=__BACKUP_DIR__

# --- Canister (Internet Computer) ---
IC_HOST=https://icp-api.io
CANISTER_ID=
# Khoá HMAC dùng chung với canister — sinh bằng: openssl rand -hex 32
# rồi đặt cùng giá trị trên canister qua trang quản trị.
VPS_SECRET=

# --- Nhiều đối tác ---
# Đối tác của đơn cũ / request không gửi tenantId (slug đã chuẩn hoá).
DEFAULT_TENANT_ID=bunbohue65
# Đối tác được TỰ ĐỘNG xuất hoá đơn Bkav bằng tài khoản Bkav bên dưới (cách
# nhau dấu phẩy). Quán khác chưa có tài khoản hoá đơn riêng thì không xuất.
BKAV_TENANT_IDS=bunbohue65

# --- Tingee (QR thanh toán) ---
TINGEE_BASE_URL=https://open-api.tingee.vn
TINGEE_CLIENT_ID=
TINGEE_SECRET=
TINGEE_BANK_BIN=
TINGEE_VA_ACCOUNT_NUMBER=

# --- Lalamove ---
# sandbox khi thử nghiệm; đổi thành production khi chạy thật
LALAMOVE_ENV=sandbox
LALAMOVE_MARKET=VN
LALAMOVE_LANGUAGE=vi_VN
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_AUTO_DISPATCH=false

# --- Bkav (hoá đơn của chính Tôi Đặt Món) ---
BKAV_PROXY_PORT=__BKAV_PROXY_PORT__
BKAV_PROXY_URL=http://127.0.0.1:__BKAV_PROXY_PORT__
BKAV_USE_DEMO=true
BKAV_PARTNER_GUID=
BKAV_PARTNER_TOKEN=
BKAV_CMD_TYPE=
BKAV_INVOICE_FORM=
BKAV_PROD_INVOICE_SERIAL=
BKAV_PROD_ENDPOINT=
BKAV_DEMO_ENDPOINT=
BKAV_PDF_BASE_URL=

# --- Email (OTP, thông báo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=toando7990@gmail.com

# --- Khác ---
ANALYTICS_API_KEY=
GEOCODE_USER_AGENT=toidatmon.vn (toando7990@gmail.com)
